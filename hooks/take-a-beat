#!/usr/bin/env bash
set -uo pipefail
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
source "${SCRIPT_DIR}/lib/playbook-common.sh"

stdin="$(cat 2>/dev/null || true)"
command -v jq >/dev/null 2>&1 || exit 0
event="$(jq -r '.hook_event_name // empty' 2>/dev/null <<<"$stdin" || true)"

CALM_PCT="${PLAYBOOK_CALM_PCT:-80}"; case "$CALM_PCT" in ''|*[!0-9]*) CALM_PCT=80 ;; esac
CARD="📚 Playbook: new work? Goal still right?"
ANCHOR_CAP=9000

case "$event" in SessionStart|UserPromptSubmit|PostToolBatch) ;; *) exit 0 ;; esac

live="$(playbook_live_dir "$stdin")"
[ -n "$live" ] || exit 0
playbook_lock "$live"
dir="$live"

append_seg() {
  local a="${1:-}" b="${2:-}"
  if [ -z "$b" ]; then printf '%s' "$a"; return 0; fi
  if [ -z "$a" ]; then printf '%s' "$b"; return 0; fi
  printf '%s\n\n%s' "$a" "$b"
}

ratchet_window() {
  [ "${1:-0}" -gt 200000 ] 2>/dev/null || return 0
  [ -n "$(playbook_state_get "$dir" window_proven)" ] || playbook_state_put "$dir" "window_proven=1000000"
}

calm_body() {
  local used="$1" win="$2" prov="$3" pct="$4"
  if [ "$prov" = "proven" ]; then
    printf 'Playbook context calm: context is at about %s percent of your %s-token window. Auto-compact is seamless and the session keeps going; the platform will not stop you. You keep what matters: the confirmed goal, the user'"'"'s words behind it and their decisions come back for you after compaction. Keep working at the same completeness bar.' "$pct" "$win"
  else
    printf 'Playbook context calm: about %s tokens are in use this session. On a standard 200000-token window that is close to the auto-compact point; on a one-million window there is ample room, and either way nothing needs to change. Auto-compact is seamless and the session keeps going; the platform will not stop you. You keep what matters: the confirmed goal, the user'"'"'s words behind it and their decisions come back for you after compaction. Keep working at the same completeness bar.' "$used"
  fi
}

anchor_body() {
  local st goal mode route words decisions lvl gate head tail room wb db
  st="$(playbook_ns_state "$dir")"; goal="$(playbook_ns_goal "$dir")"
  case "$st" in
    confirmed) head="Confirmed goal: ${goal}" ;;
    stale)     head="Goal awaiting re-confirmation (stale): ${goal}" ;;
    done)      head="Goal marked complete: ${goal}. New work needs a new goal." ;;
    *)         head="No confirmed goal." ;;
  esac
  mode="$(playbook_mode "$dir")"; route="$(playbook_state_get "$dir" route_reason)"
  if [ -n "$mode" ]; then head="${head}
Mode: ${mode}${route:+ (${route})}"; else head="${head}
Mode: none declared."; fi
  lvl="$(playbook_level_name "$(playbook_level_of "$(playbook_state_int "$dir" score10 0)")")"
  gate="$(playbook_gate "$dir")"
  tail="Unease: ${lvl}, score $(playbook_score_text "$dir")${gate:+; gate: ${gate}}."
  room=$(( ANCHOR_CAP - ${#head} - ${#tail} - 700 ))
  wb=$(( room * 55 / 100 )); db=$(( room - wb ))
  words="$(playbook_ns_words_text "$dir")"
  if [ "${#words}" -gt "$wb" ]; then words="${words:$(( ${#words} - wb ))}"; fi
  decisions="$(playbook_decisions_text "$dir" "$db")"
  printf 'Playbook re-anchor after compaction. Nothing you need was lost.\n\n%s\n\n' "$head"
  [ -n "$words" ] && printf "The user's own words behind the goal, verbatim:\n%s\n\n" "$words"
  [ -n "$decisions" ] && printf "The user's decisions, verbatim; they outrank you and every helper, reviewer, judge and reviser:\n%s\n\n" "$decisions"
  printf '%s\n\nResume the in-flight work where you left off; compaction is not a reason to stop.' "$tail"
}

statusline_check() {
  local gdir="$1" proj="$2" marker plugin_copy installed cmd f
  marker="$(playbook_global_file statusline)"
  [ "$marker" = "owned" ] || return 0
  installed="${gdir}/bin/statusline"; plugin_copy="${SCRIPT_DIR}/../scripts/statusline"
  if [ -f "$plugin_copy" ] && ! cmp -s "$plugin_copy" "$installed" 2>/dev/null; then
    { mkdir -p "${gdir}/bin" && cp "$plugin_copy" "$installed" && chmod +x "$installed"; } 2>/dev/null || true
  fi
  cmd=""
  for f in "${proj}/.claude/settings.local.json" "${proj}/.claude/settings.json" "${HOME}/.claude/settings.json"; do
    [ -f "$f" ] || continue
    cmd="$(jq -r '.statusLine.command // empty' "$f" 2>/dev/null)"
    [ -n "$cmd" ] && break
  done
  case "$cmd" in *playbook/bin/statusline*|"${installed}"*) return 0 ;; esac
  [ "$(cat "${gdir}/statusline-offered" 2>/dev/null)" = "$cmd" ] && return 0
  { mkdir -p "$gdir" && printf '%s' "$cmd" > "${gdir}/statusline-offered"; } 2>/dev/null || true
  printf 'Playbook status line: the status line Playbook wrapped (goal, mode and unease) is no longer the configured one%s, most likely replaced by a plugin update. Offer the user, once, to wrap it again: with their consent, back up the settings file, save the current statusLine command to ${gdir}/statusline-wrapped, and point statusLine.command at ${gdir}/bin/statusline. If they decline for good, write the word skipped to ${gdir}/statusline so this stops; otherwise it is offered again only if the status line changes again. Never edit settings without their explicit consent.' "${cmd:+ (it is now: ${cmd})}"
}

case "$event" in
  SessionStart)
    src="$(jq -r '.source // empty' 2>/dev/null <<<"$stdin" || true)"
    if [ "$src" = "compact" ]; then
      playbook_state_put "$dir" "calm_fired=0" "nudge200_fired=0"
      body="$(anchor_body)"
      playbook_emit_context "SessionStart" "${body:0:$ANCHOR_CAP}"
    else
      [ "$src" = "clear" ] && { playbook_conversation_reset "$dir"; playbook_state_put "$dir" "iface_path=" "iface_hash=" "iface_ver=0" "rg_open=" "rg_ok=" "rg_by=" "rg_id=" "rg_noted=" "rg_closed_noted=" "rg_how=" "rg_reset=" "rg_reset_noted=" "rg_reset_by=" "crew_msgs=" "crew_last=" "crew_last_at=" "lead_idle=" "weigh=" "cap_notice=" "branch_notice="; rm -rf "${dir}/team" "${dir}/mail" "${dir}/review_ids" "${dir}/weigh_seen" "${dir}/weigh_told" 2>/dev/null; }
      playbook_state_gc
      body=""
      proj="$(playbook_project_dir "$stdin")"
      gdir="$(playbook_global_dir)"
      comp="$(playbook_competing_context_hook "$proj")"
      resolved="$(playbook_context_calm_resolved "$proj")"
      if [ -n "$comp" ] && [ -z "$resolved" ]; then
        body="Playbook context-calm offer: a competing context-warning hook (${comp}) is registered on this machine. Near the context limit it injects wrap-up-and-stop messages into the agent, which makes work halt early and breaks offline runs. Offer the user, once, to let Playbook own the context channel instead and keep working calmly through auto-compact. If they accept: in a GSD project set hooks.context_warnings to false in .planning/config.json; otherwise back up the settings file and remove the ${comp} PostToolUse registration from it. Then write the word owned to ${gdir}/context-calm. If they decline, write the word declined to ${gdir}/context-calm. Either marker stops this offer repeating. Never edit settings without the user's explicit consent, and always back up first."
      elif [ -n "$comp" ] && [ "$resolved" = "owned" ]; then
        body="Playbook context-calm: the competing context-warning hook (${comp}) has come back since the user let Playbook own the context channel, most likely re-registered by a plugin update. Near the context limit it will again inject wrap-up-and-stop messages. Offer the user, once this session, to quiet it again: back up the settings file and remove the ${comp} PostToolUse registration, or in a GSD project set hooks.context_warnings to false in .planning/config.json. If they now prefer to keep the warning hook, write the word declined to ${gdir}/context-calm so this stops re-surfacing. Treat its warnings as background noise either way: auto-compact is seamless and context pressure is never a reason to do less. Never edit settings without the user's explicit consent, and always back up first."
      fi
      body="$(append_seg "$body" "$(statusline_check "$gdir" "$proj")")"
      if [ ! -f "${gdir}/setup" ] && [ ! -f "${gdir}/setup-nudged" ]; then
        nudge="Playbook setup has not run on this machine. At a natural pause in your first reply, add one short line suggesting the user type /playbook:hello so Playbook can introduce itself and, with their permission, check once for plugin conflicts (hooks that re-prompt on Stop or inject context-limit warnings), confirm jq, and optionally set up offline notifications. Do not run the check unasked, and do not repeat the suggestion on later turns."
        body="$(append_seg "$body" "$nudge")"
        { mkdir -p "$gdir" && printf 'nudged\n' > "${gdir}/setup-nudged"; } 2>/dev/null || true
      fi
      if [ -n "$body" ]; then playbook_emit_context "SessionStart" "$body"; fi
    fi
    ;;

  UserPromptSubmit)
    text="$(jq -r '.prompt // empty' 2>/dev/null <<<"$stdin" || true)"
    playbook_human_message "$dir" "$text" || true
    while IFS= read -r rid; do [ -n "$rid" ] && playbook_weigh_arm "$dir" "$rid"; done < <(playbook_report_review_ids "$dir" "$text")
    playbook_weigh_tell_any "$dir" && playbook_event_push "$dir" "$PLAYBOOK_WEIGH_TEXT"
    turn_wf=0
    case "$(printf '%s' "$text" | sed -E 's/^[[:space:]]+//')" in /playbook:workflow|/playbook:workflow[[:space:]]*|/workflow|/workflow[[:space:]]*) turn_wf=1 ;; esac
    turn_kw=0
    printf '%s' "$text" | grep -qiE '(^|[^a-z])ultracode([^a-z]|$)' && turn_kw=1
    playbook_state_put "$dir" "turn_at=$(playbook_now)" "turn_wf=${turn_wf}" "turn_kw=${turn_kw}"
    body="$CARD"
    if [ "$(playbook_state_get "$dir" wf_optin)" = "pending" ] && [ "$turn_kw" = 1 ]; then
      body="$(append_seg "$body" "Playbook: the user has typed the workflows opt-in. If the plan is settled, start the Workflow tool in this turn; the dispatch guard checks Claude Code's record of the opt-in.")"
    fi
    if [ "$turn_kw" = 1 ] || [ "$turn_wf" = 1 ]; then
      body="$(append_seg "$body" "$PLAYBOOK_WF_MODEL_LINE")"
    fi
    if [ "$(playbook_state_get "$dir" branch_notice)" = "1" ]; then
      body="$(append_seg "$body" "Playbook: this terminal branched from a session that is still running, so it works on its own copy of the state from here; the original keeps its own.")"
      playbook_state_put "$dir" "branch_notice="
    fi
    body="$(append_seg "$body" "$(playbook_event_drain "$dir")")"
    playbook_emit_context "UserPromptSubmit" "$body"
    ;;

  PostToolBatch)
    [ -z "$(playbook_agent_id "$stdin")" ] || exit 0
    playbook_batch "$dir"
    playbook_tick "$dir"
    used="$(playbook_context_used "$stdin" || true)"
    case "$used" in
      ''|*[!0-9]*) : ;;
      *)
        ratchet_window "$used"
        if [ "$used" -gt 200000 ] && [ "$(playbook_state_int "$dir" nudge200_fired 0)" -eq 0 ]; then
          playbook_state_put "$dir" "nudge200_fired=1"
          playbook_event_push "$dir" "Playbook: context has passed 200k tokens. At the next natural finish, a fresh session with a short handover costs less than carrying on; never stop mid-task for it."
        fi
        win="$(playbook_window "$dir")"; prov="$(playbook_window_provenance "$dir")"
        pct="$(playbook_percent "$used" "$win")"
        if [ -n "$pct" ] && [ "$pct" -ge "$CALM_PCT" ] 2>/dev/null && [ "$(playbook_state_int "$dir" calm_fired 0)" -eq 0 ]; then
          playbook_state_put "$dir" "calm_fired=1"
          playbook_event_push "$dir" "$(calm_body "$used" "$win" "$prov" "$pct")"
        fi ;;
    esac
    playbook_score_settle "$dir"
    ctx="$(playbook_event_drain "$dir")"
    [ -n "$ctx" ] && playbook_emit_context "PostToolBatch" "$ctx"
    ;;
esac
exit 0
